# 复制为 .env 后按需修改：cp .env.example .env
# 本机试用可全部保持默认；对外部署前三个务必更换。

# PostgreSQL 密码（两节点连接串同用）
POSTGRES_PASSWORD=htagent-docker

# JWT 签名密钥：至少 32 字节。生成一个随机的：openssl rand -base64 48
JWT_SIGNING_KEY=htagent-compose-default-signing-key-0123456789

# 节点同步令牌：公司节点携带、总部节点校验，至少 16 位
SYNC_TOKEN=htagent-sync-token-compose-default

# 初始管理员（admin）密码——只在数据库首次初始化时生效；之后改密码走界面
ADMIN_PASSWORD=Admin@12345

# 端口映射（与本机已有服务冲突时改这里）
WEB_PORT=8080          # 公司内网界面
HQ_WEB_PORT=8081       # 总部审核台
PORTAL_PORT=8082       # 客户门户
COMPANY_API_PORT=8090  # 公司节点 API（直连调试用）
HQ_API_PORT=8091       # 总部节点 API（直连调试用）
